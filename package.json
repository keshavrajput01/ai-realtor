{\n  "name": "ai-realtor",\n  "version": "0.1.0",\n  "description": "AI Real-Estate Calling System - Free-first voice calling for lead qualification",\n  "private": true,\n  "scripts": {\n    "dev": "concurrently \"npm run dev --workspace=apps/backend\" \"npm run dev --workspace=apps/frontend\"",\n    "build": "npm run build --workspace=apps/backend && npm run build --workspace=apps/frontend",\n    "start": "npm start --workspace=apps/backend",\n    "db:migrate": "npm run db:migrate --workspace=apps/backend",\n    "db:push": "npm run db:push --workspace=apps/backend",\n    "db:seed": "npm run db:seed --workspace=apps/backend",\n    "test": "npm run test --workspace=apps/backend && npm run test --workspace=apps/frontend",\n    "lint": "npm run lint --workspace=apps/backend && npm run lint --workspace=apps/frontend"\n  },\n  "workspaces": [\n    "apps/backend",\n    "apps/frontend"\n  ],\n  "devDependencies": {\n    "concurrently": "^8.2.1",\n    "typescript": "^5.2.2"\n  }\n}\n