// This is your Prisma schema file,\n// learn more about it in the docs: https://pris.ly/d/prisma-schema\n\ngenerator client {\n  provider = "prisma-client-js"\n}\n\ndatasource db {\n  provider = "postgresql"\n  url      = env("DATABASE_URL")\n}\n\n// Users and Authentication\nmodel User {\n  id        String   @id @default(cuid())\n  email     String   @unique\n  password  String\n  firstName String?\n  lastName  String?\n  phone     String?\n  avatar    String?\n  role      String   @default("user")\n  status    String   @default("active")\n\n  // Relations\n  leads        Lead[]\n  projects     Project[]\n  callSessions CallSession[]\n  followUps    FollowUp[]\n  aiSettings   AiSettings?\n  aiUsage      AiUsage[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([email])\n  @@index([status])\n}\n\n// Leads\nmodel Lead {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  \n  // Basic Info\n  firstName       String?\n  lastName        String?\n  fullName        String?\n  phone           String\n  email           String?\n  \n  // Location & Property\n  city            String?\n  location        String?\n  budget          String?\n  projectId       String?\n  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)\n  propertyType    String?\n  purpose         String?  // "investment" or "end-use"\n  source          String?\n  \n  // Status & Qualification\n  leadStatus      String   @default("new")  // new, contacted, qualified, hot, warm, cold, not_interested, callback\n  aiScore         Int      @default(0)      // 0-100\n  aiIntent        String?  // hot, warm, cold, not_interested, callback\n  callStatus      String   @default("pending")  // pending, in_progress, completed, failed\n  \n  // Timestamps\n  lastCalledAt    DateTime?\n  nextFollowupAt  DateTime?\n  \n  // Data\n  notes           String?\n  aiSummary       String?\n  customFields    Json     @default("{}")\n  \n  // Relations\n  callSessions    CallSession[]\n  followUps       FollowUp[]\n  callOutcomes    CallOutcome[]\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  \n  @@unique([userId, phone])\n  @@index([userId])\n  @@index([leadStatus])\n  @@index([aiScore])\n  @@index([nextFollowupAt])\n}\n\n// Projects (Real Estate Properties)\nmodel Project {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  \n  name            String\n  location        String\n  description     String?\n  \n  // Project Details\n  unitTypes       String[]  // e.g., [\"1BHK\", \"2BHK\", \"3BHK\"]\n  sizes           String[]  // e.g., [\"500-700\", \"700-1000\"]\n  prices          String[]  // e.g., [\"₹50L - ₹75L\"]\n  usps            String[]  // Unique selling points\n  amenities       String[]\n  paymentPlan     String?\n  possession      String?\n  reraInfo        String?\n  \n  // Relations\n  leads           Lead[]\n  knowledge       ProjectKnowledge[]\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  \n  @@index([userId])\n}\n\n// Project Knowledge Base\nmodel ProjectKnowledge {\n  id              String   @id @default(cuid())\n  projectId       String\n  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  \n  category        String   // e.g., \"faq\", \"objection\", \"feature\", \"pricing\"\n  title           String\n  content         String   // Full text content\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  \n  @@index([projectId])\n  @@index([category])\n}\n\n// Call Sessions\nmodel CallSession {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  leadId          String\n  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)\n  \n  status          String   @default("initiated")  // initiated, ringing, connected, completed, failed\n  callType        String   @default("outbound")   // outbound, inbound\n  provider        String   @default("browser-webrtc")  // browser-webrtc, sip, twilio, etc.\n  \n  // Duration\n  startedAt       DateTime\n  endedAt         DateTime?\n  durationSeconds Int      @default(0)\n  \n  // Call Data\n  transcript      String?  // Full conversation text\n  recording       String?  // URL to recording (if stored)\n  \n  // Relations\n  events          CallEvent[]\n  transcripts     CallTranscript[]\n  outcome         CallOutcome?\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  \n  @@index([userId])\n  @@index([leadId])\n  @@index([status])\n  @@index([createdAt])\n}\n\n// Call Transcripts (Individual messages)\nmodel CallTranscript {\n  id              String   @id @default(cuid())\n  sessionId       String\n  session         CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  \n  speaker         String   // \"user\" or \"ai\"\n  text            String\n  audioUrl        String?  // URL to audio file (if stored)\n  \n  // Language detection\n  language        String   @default("en")  // en, hi, hinglish\n  confidence      Float    @default(1.0)\n  \n  timestamp       DateTime @default(now())\n  sequenceNumber  Int\n  \n  @@index([sessionId])\n  @@index([speaker])\n}\n\n// Call Events (System events during call)\nmodel CallEvent {\n  id              String   @id @default(cuid())\n  sessionId       String\n  session         CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  \n  eventType       String   // \"stt_start\", \"stt_complete\", \"ai_thinking\", \"ai_response\", \"tts_start\", \"tts_complete\", \"error\"\n  data            Json     // Event-specific data\n  \n  timestamp       DateTime @default(now())\n  \n  @@index([sessionId])\n  @@index([eventType])\n}\n\n// Call Outcomes (Results and scoring)\nmodel CallOutcome {\n  id              String   @id @default(cuid())\n  sessionId       String   @unique\n  session         CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  leadId          String   @unique\n  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)\n  \n  // Summary\n  summary         String   // 2-5 sentences\n  \n  // Qualification\n  intent          String   // HOT, WARM, COLD, NOT_INTERESTED, CALLBACK\n  score           Int      @default(0)  // 0-100\n  \n  // Extracted Information\n  budget          String?\n  location        String?\n  propertyType    String?\n  purpose         String?  // investment or end-use\n  timeline        String?  // e.g., \"30-60 days\"\n  \n  // Objections and Next Steps\n  objections      String[]  // Array of objections raised\n  nextAction      String?   // e.g., \"call_tomorrow\", \"send_details\", \"schedule_site_visit\"\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  \n  @@index([leadId])\n  @@index([intent])\n  @@index([score])\n}\n\n// Follow-ups\nmodel FollowUp {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  leadId          String\n  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)\n  \n  type            String   // \"call\", \"sms\", \"email\", \"whatsapp\", \"manual\"\n  title           String   // e.g., \"Follow-up call\"\n  description     String?\n  \n  status          String   @default("pending")  // pending, completed, cancelled\n  \n  scheduledAt     DateTime\n  completedAt     DateTime?\n  notes           String?  // Outcome notes\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  \n  @@index([userId])\n  @@index([leadId])\n  @@index([status])\n  @@index([scheduledAt])\n}\n\n// AI Settings (Per user)\nmodel AiSettings {\n  id              String   @id @default(cuid())\n  userId          String   @unique\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  \n  systemPrompt    String   @default("")  // Custom system prompt\n  voiceName       String   @default("default")\n  language        String   @default("en")\n  \n  // Objection Handling Templates\n  objectionHandling Json   @default("{}")\n  \n  // Call Behavior\n  maxCallDuration Int      @default(600)  // seconds\n  enableRecording Boolean  @default(false)\n  \n  updatedAt       DateTime @updatedAt\n}\n\n// AI Usage Tracking (For cost monitoring)\nmodel AiUsage {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  \n  provider        String   // \"ollama\", \"openai\", \"whisper\", \"gtts\", etc.\n  service         String   // \"ai\", \"stt\", \"tts\", \"telephony\"\n  \n  inputTokens     Int      @default(0)\n  outputTokens    Int      @default(0)\n  cost            Float    @default(0)\n  \n  date            DateTime @default(now())\n  \n  @@index([userId])\n  @@index([provider])\n  @@index([date])\n}\n